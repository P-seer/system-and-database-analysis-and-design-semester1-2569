-- ข้อ 1 ลบและสร้างฐานข้อมูล shopdb ใหม่ รองรับภาษาไทย
DROP DATABASE IF EXISTS shopdb;
CREATE DATABASE shopdb
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;
USE shopdb;


-- ข้อ 2 สร้างตาราง CATEGORY
CREATE TABLE CATEGORY (
    category_id INT AUTO_INCREMENT PRIMARY KEY,
    category_name VARCHAR(50) NOT NULL UNIQUE
);


-- ข้อ 3 สร้างตาราง CUSTOMER
CREATE TABLE CUSTOMER (
    customer_id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    phone VARCHAR(15),
    registered_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- ข้อ 4 สร้างตาราง PRODUCT พร้อม Foreign Key และ CHECK
CREATE TABLE PRODUCT (
    product_id INT AUTO_INCREMENT PRIMARY KEY,
    product_name VARCHAR(100) NOT NULL,
    category_id INT,
    price DECIMAL(10,2) NOT NULL,
    stock INT NOT NULL DEFAULT 0,
    CONSTRAINT fk_product_category
      FOREIGN KEY (category_id) REFERENCES CATEGORY(category_id),
    CONSTRAINT chk_product_price CHECK (price > 0),
    CONSTRAINT chk_product_stock CHECK (stock >= 0)
);


-- ข้อ 5 สร้างตาราง ORDERS
CREATE TABLE ORDERS (
    order_id INT AUTO_INCREMENT PRIMARY KEY,
    customer_id INT NOT NULL,
    order_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(20) NOT NULL DEFAULT 'pending',
    shipping_fee DECIMAL(8,2) NOT NULL DEFAULT 0,
    CONSTRAINT fk_orders_customer
      FOREIGN KEY (customer_id) REFERENCES CUSTOMER(customer_id),
    CONSTRAINT chk_orders_status
      CHECK (status IN ('pending','paid','shipped','delivered','cancelled'))
);


-- ข้อ 6 สร้างตาราง PROMOTION
CREATE TABLE PROMOTION (
    promo_code VARCHAR(20) PRIMARY KEY,
    discount_percent INT NOT NULL,
    valid_until DATE NOT NULL,
    CONSTRAINT chk_promotion_discount
      CHECK (discount_percent BETWEEN 1 AND 90)
);


-- ข้อ 7 สร้างตาราง ORDER_ITEM ใช้ Primary Key แบบผสม
CREATE TABLE ORDER_ITEM (
    order_id INT NOT NULL,
    product_id INT NOT NULL,
    quantity INT NOT NULL,
    unit_price DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (order_id, product_id),
    CONSTRAINT fk_order_item_order
      FOREIGN KEY (order_id) REFERENCES ORDERS(order_id)
      ON DELETE CASCADE,
    CONSTRAINT fk_order_item_product
      FOREIGN KEY (product_id) REFERENCES PRODUCT(product_id),
    CONSTRAINT chk_order_item_quantity CHECK (quantity > 0)
);


-- ข้อ 8 สร้างตาราง PAYMENT ให้หนึ่งคำสั่งซื้อชำระได้ครั้งเดียว
CREATE TABLE PAYMENT (
    payment_id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT NOT NULL UNIQUE,
    method VARCHAR(20) NOT NULL,
    amount DECIMAL(10,2) NOT NULL,
    paid_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_payment_order
      FOREIGN KEY (order_id) REFERENCES ORDERS(order_id),
    CONSTRAINT chk_payment_method
      CHECK (method IN ('credit_card','bank_transfer','promptpay','cod'))
);



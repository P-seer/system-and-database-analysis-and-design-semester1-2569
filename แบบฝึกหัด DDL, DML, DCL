-- ฝ่ายบริการลูกค้า: อ่าน CUSTOMER, ORDERS, ORDER_ITEM
-- และแก้ไขได้เฉพาะ status ของ ORDERS
CREATE ROLE 'cs_role';
GRANT SELECT ON shopdb.CUSTOMER TO 'cs_role';
GRANT SELECT ON shopdb.ORDERS TO 'cs_role';
GRANT UPDATE (status) ON shopdb.ORDERS TO 'cs_role';
GRANT SELECT ON shopdb.ORDER_ITEM TO 'cs_role';
GRANT 'cs_role' TO 'sales01'@'%';
SET DEFAULT ROLE 'cs_role' TO 'sales01'@'%';

-- ฝ่ายคลังสินค้า: อ่าน PRODUCT และแก้ไขเฉพาะ stock
CREATE ROLE 'warehouse_role';
GRANT SELECT ON shopdb.PRODUCT TO 'warehouse_role';
GRANT UPDATE (stock) ON shopdb.PRODUCT TO 'warehouse_role';
GRANT 'warehouse_role' TO 'staff01'@'localhost';
SET DEFAULT ROLE 'warehouse_role' TO 'staff01'@'localhost';


-- ข้อ 60 staff01 ลาออก: ถอนสิทธิ์ทั้งหมดรวม Role ตรวจสอบ แล้วลบบัญชี
-- ถอน Role ที่ได้รับ
REVOKE 'warehouse_role' FROM 'staff01'@'localhost';

-- ถอนสิทธิ์และสิทธิ์ส่งต่อทั้งหมด
REVOKE ALL PRIVILEGES, GRANT OPTION
FROM 'staff01'@'localhost';

-- ตรวจสอบสิทธิ์ที่เหลือก่อนลบบัญชี
SHOW GRANTS FOR 'staff01'@'localhost';

-- ลบบัญชีผู้ใช้
DROP USER 'staff01'@'localhost';
